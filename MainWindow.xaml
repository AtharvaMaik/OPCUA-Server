<Window x:Class="MtpSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MTP OPC UA Simulator" Height="440" Width="860">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Top Controls -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Top">
            <Button Name="BtnLoadAml" Width="120" Click="BtnLoadAml_Click">Load AML</Button>

            <Separator Width="8" Opacity="0"/>

            <Button Name="BtnStartServer" Width="120" Margin="0,0,8,0" Click="BtnStartServer_Click">Start Server</Button>
            <Button Name="BtnStopServer" Width="120" Margin="0,0,12,0" Click="BtnStopServer_Click">Stop Server</Button>

            <TextBlock Margin="0,4,6,0" VerticalAlignment="Center">Endpoint:</TextBlock>
            <TextBox Name="TxtEndpoint" IsReadOnly="True" Width="280" />

            <Separator Width="16" Opacity="0"/>

            <TextBlock Margin="0,4,6,0" VerticalAlignment="Center">Sim Interval (ms):</TextBlock>
            <TextBox Name="TxtSimInterval" Width="80" Text="1000" VerticalContentAlignment="Center" />

            <Separator Width="8" Opacity="0"/>

            <Button Name="BtnStartSim" Width="140" Margin="0,0,8,0" Click="BtnStartSim_Click">Start Simulation</Button>
            <Button Name="BtnStopSim" Width="140" Click="BtnStopSim_Click">Stop Simulation</Button>

            <Separator Width="16" Opacity="0"/>

            <Button Name="BtnFillDefaults" Width="140" Click="BtnFillDefaults_Click">Fill Defaults</Button>
        </StackPanel>

        <!-- Items Grid -->
        <GroupBox Header="Parsed Items (edit DataType / InitialValue here)" Grid.Row="1">
            <DataGrid Name="GridItems"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="0">
                <DataGrid.Columns>
                    <!-- Read-only columns -->
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Identifier" Binding="{Binding Identifier}" Width="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" Width="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="70" IsReadOnly="True"/>

                    <!-- Editable DataType (combo) -->
                    <DataGridComboBoxColumn Header="DataType"
                                            Width="120"
                                            SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding DataContext.SupportedDataTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>

                    <!-- Editable InitialValue (text) -->
                    <DataGridTextColumn Header="InitialValue"
                                        Binding="{Binding InitialValue, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Log -->
        <GroupBox Header="Log" Grid.Row="2" Margin="0,12,0,0">
            <TextBox Name="TxtLog"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Window>
